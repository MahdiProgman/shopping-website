<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>سبد خرید | وبسایت فروشگاهی</title>
    <link rel="icon" type="image/x-icon" href="/assets/icons/brand.svg" />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/user-panel/global.css">
    <link rel="stylesheet" href="/styles/user-panel/cart.css">
    <link rel="stylesheet" href="/libs/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="/libs/flexboxgrid/flexboxgrid.css">
    <link rel="stylesheet" href="/libs/notyf/notyf.min.css">
  </head>
  <body>
    <%- include("../includes/drawer", { page: 'cart', state: 'user-panel' }) %>
    <div class="overlay hidden"></div>
    <div class="main">
      <%- include("../includes/header", { page: 'cart' }) %>
      <div class="header-overlay hidden"></div>
      <main>
        <div class="container">
          <%- include("includes/menu", { page: 'cart' }) %>
          <div class="content">
            <% if(!userCart) { %>
              <h2>سبد خرید</h2>
              <div class="no-data">
                <img src="/assets/icons/no-data.png" alt="" />
                <span>تاکنون شما محصولی به سبد خرید خود اضافه نکرده اید.</span>
              </div>
            <% } else { %>
              <div class="products-list">
                <h3>سبد خرید • <%= toPersianDigitsHelper(userCart ? userCart.length : 0) %> محصول</h3>
                <div class="products">
                  <% userCart.map(product => { %>
                    <div class="product">
                      <a href="/product/<%= product.product_code %>">
                        <div class="image">
                          <img src="<%= product.image %>" alt="" />
                        </div>
                        <div class="detail">
                          <h5><%= product.title %></h5>
                          <div class="rate">
                            <img src="/assets/icons/star.png" alt="" />
                            <span class="rate-number"><%= toPersianDigitsHelper(product.rate) %></span>
                          </div>
                          <span class="price"><%= product.price_fa %> تومان</span>
                          <form action="/user/cart/remove/<%= product.product_code %>" method="post">
                            <button class="delete-product">
                              <img src="/assets/icons/trash.svg" alt="" />
                            </button>
                          </form>
                        </div>
                      </a>
                    </div>
                  <% }); %>
                </div>
              </div>
              <div class="order-details">
                <h5>جزییات سفارش</h5>
                <span class="sum-of-all">جمع کل : <%= toPersianDigitsHelper(totalPrice.toLocaleString()) %> تومان</span>
                <span class="payable">قابل پرداخت : <%= toPersianDigitsHelper(totalPrice.toLocaleString()) %> تومان</span>
                <button class="place-order-btn">ثبت سفارش</button>
              </div>
            <% } %>
          </div>
        </div>
      </main>
      <%- include("../includes/footer") %>
    </div>
    <script src="/libs/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="/libs/notyf/notyf.min.js"></script>
    <script>
      const notyf = new Notyf({
        duration: 3000,
        ripple: true,
        position: {
          x: "left",
          y: "top",
        },
      });

      if("<%= isProductRemovedFromCart %>" == "true") notyf.success('محصول مورد نظر با موفقیت از سبد خرید حذف شد')
    </script>
    <script src="/scripts/global.js"></script>
  </body>
</html>
