<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>علاقه مندی ها | وبسایت فروشگاهی</title>
    <link rel="icon" type="image/x-icon" href="/assets/icons/brand.svg" />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/user-panel/global.css">
    <link rel="stylesheet" href="/styles/user-panel/favorites.css">
    <link rel="stylesheet" href="/libs/sweetalert2/sweetalert2.min.css" />
  </head>
  <body>
    <%- include("../includes/drawer", { page: 'favorites', state: 'user-panel' }) %>
    <div class="overlay hidden"></div>
    <div class="main">
      <%- include("../includes/header", { page: 'favorites' }) %>
      <div class="header-overlay hidden"></div>
      <main>
        <div class="container">
          <%- include("includes/menu", { page: 'favorites' }) %>
          <div class="content">
            <h2>لیست علاقه مندی ها • <%= toPersianDigitsHelper(userFavorites ? userFavorites.length : 0) %> محصول</h2>
            <% if (!userFavorites) { %>
              <div class="no-data">
                <img src="/assets/icons/no-data.png" alt="" />
                <span>محصولی اکنون در لیست علاقه مندی های شما وجود ندارد.</span>
              </div>
            <% } else { %>
              <div class="products">
                <% userFavorites.map(favorite => { %>
                  <div class="product">
                    <a href="/product/<%= favorite.product_code %>">
                      <div class="image">
                        <img src="<%= favorite.image %>" alt="" />
                      </div>
                      <div class="detail">
                        <h5><%= favorite.title %></h5>
                        <div class="rate">
                          <img src="/assets/icons/star.png" alt="" />
                          <span class="rate-number"><%= toPersianDigitsHelper(favorite.rate) %></span>
                        </div>
                        <span class="price"><%= favorite.price_fa %> تومان</span>
                        <button class="delete-product">
                          <img src="/assets/icons/trash.svg" alt="" />
                        </button>
                      </div>
                    </a>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>
      </main>
      <%- include("../includes/footer") %>
    </div>
    <script src="/libs/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="/scripts/global.js"></script>
  </body>
</html>
